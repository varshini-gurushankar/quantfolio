# API service.
#
# From Phase 3 this image also carries the ML stack, because /predict runs a
# real forward pass through the model pulled from the MLflow registry. That is a
# deliberate trade-off: one deployable instead of two, at the cost of a large
# image. The alternative — a separate inference service, with the API proxying
# to it — is the right call once model and API release cadences diverge, and is
# noted as such in the README rather than pretended away.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libpq-dev curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY config ./config

RUN pip install --no-cache-dir ".[api,ml]"

# Non-root: the API is the only container in this stack exposed to a client.
RUN useradd --create-home --uid 1000 appuser && chown -R appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "quantfolio.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
