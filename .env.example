# Copy to .env and fill in. .env is gitignored.

# --- Postgres (feature store) ---
POSTGRES_USER=quantfolio
POSTGRES_PASSWORD=quantfolio
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=quantfolio

# --- LocalStack / S3 ---
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT_URL=http://localstack:4566
S3_RAW_BUCKET=quantfolio-raw
S3_ARTIFACTS_BUCKET=quantfolio-artifacts

# --- Monitoring ---
PUSHGATEWAY_URL=http://pushgateway:9091

# --- MLflow (Phase 2) ---
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- Data sources ---
# yfinance needs no key. Alpha Vantage free tier: 25 requests/day, 5/min.
ALPHA_VANTAGE_API_KEY=

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
